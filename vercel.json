{
  "redirects": [
    {
      "source": "/resume.pdf",
      "destination": "https://kanakos01.github.io/kanakOS01/resume/resume.pdf",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}